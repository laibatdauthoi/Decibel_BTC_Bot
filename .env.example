# Read-only network selection. Defaults to testnet when omitted.
DECIBEL_NETWORK=testnet

# Optional Aptos node API key. The application never prints this value.
DECIBEL_NODE_API_KEY=

# This client intentionally supports only the BTC/USD perpetual market.
MARKET_SYMBOL=BTC/USD

# Decibel candlestick interval. The 5-minute strategy uses 5m by default.
CANDLE_INTERVAL=5m

# Dedicated backfill history window in days (1-365).
CANDLE_HISTORY_DAYS=90

# Informational safety flag. No order execution exists in this service.
LIVE_TRADING_ENABLED=false

# Human-readable local logs (pretty) or newline-delimited structured records (json).
LOG_FORMAT=pretty
