# Read-only network selection. Defaults to testnet when omitted.
DECIBEL_NETWORK=testnet

# Optional Aptos node API key. The application never prints this value.
DECIBEL_NODE_API_KEY=

# Deterministic offline risk policy (does not enable trading).
REFERENCE_ACCOUNT_EQUITY_USD=30
REQUIRED_ORDER_LEVERAGE=40
RISK_PER_TRADE_RATIO=0.0025
MAX_ALLOCATED_MARGIN_RATIO=1
MAX_ACCOUNT_EXPOSURE_MULTIPLE=40
MAX_OPEN_POSITIONS=1
MAX_OPEN_ENTRY_ORDERS=1
MAX_DAILY_LOSS_RATIO=0.01
MAX_ACCOUNT_DRAWDOWN_RATIO=0.05
MAX_CONSECUTIVE_LOSSES=3
LOSS_COOLDOWN_MINUTES=60
MIN_AVAILABLE_COLLATERAL_BUFFER_RATIO=0.10
MIN_STOP_DISTANCE_TICKS=2
MAX_STOP_DISTANCE_RATIO=0.05
HEALTHY_STABILIZATION_SECONDS=60
DAILY_VOLUME_TARGET_USD=10000
DAILY_MINIMUM_FILLED_VOLUME_USD=10000
PAPER_ORDER_PLACEMENT_LATENCY_MS=250
PAPER_ORDER_CANCEL_LATENCY_MS=250
ENTRY_ORDER_TTL_SECONDS=30
CANCEL_CONFIRMATION_TIMEOUT_MS=5000

# Unified paper bot. OBSERVE_ONLY is the safe default.
# OBSERVE_ONLY or PAPER_SIMULATION. Both are non-live.
PAPER_BOT_MODE=OBSERVE_ONLY
PAPER_STOP_ATR_PERIOD=14
PAPER_STOP_ATR_MULTIPLE=1
PAPER_TAKE_PROFIT_R_MULTIPLE=1.5
PAPER_MAX_HOLDING_BARS=12
PAPER_ENTRY_TTL_SECONDS=30
PAPER_RESEARCH_MINIMUM_SAMPLES=100
PAPER_RESEARCH_MAX_AGE_HOURS=168
PAPER_BOT_READINESS_TIMEOUT_SECONDS=900
PAPER_BOT_SHUTDOWN_TIMEOUT_MS=15000
PAPER_RISK_MAX_POSITION_SIZE=0.1
PAPER_RISK_MAX_NOTIONAL_EXPOSURE=20000
PAPER_RISK_MAX_TRADE_NOTIONAL=5000
PAPER_RISK_MAX_DAILY_LOSS=500
PAPER_RISK_MAX_DRAWDOWN=0.1
PAPER_RISK_MIN_CASH_RESERVE=1000
PAPER_RISK_FEE_BPS=1
PAPER_RISK_SLIPPAGE_BPS=2
PAPER_RISK_COOLDOWN_CANDLES=1
PAPER_RISK_ALLOW_REVERSAL=false
PAPER_RISK_ALLOW_INCREASE_POSITION=false
PAPER_RISK_ALLOW_REDUCE_POSITION=true
MAKER_FEE_RATE=0.00011
EMERGENCY_TAKER_FEE_RATE=0.00034
MAX_CANDLE_AGE_MS=360000
MAX_BOOK_AGE_MS=2000
MAX_TRADE_AGE_MS=120000
MAX_MARKET_PRICE_AGE_MS=5000
MAX_AGGREGATE_AGE_MS=2000
MAX_CLOCK_SKEW_MS=1000

# This client intentionally supports only the BTC/USD perpetual market.
MARKET_SYMBOL=BTC/USD

# Decibel candlestick interval. The 5-minute strategy uses 5m by default.
CANDLE_INTERVAL=5m

# Dedicated backfill history window in days (1-365).
CANDLE_HISTORY_DAYS=90
CANDLE_GAP_RECONCILIATION_MAX_ATTEMPTS=3
CANDLE_GAP_RECONCILIATION_BASE_DELAY_MS=1000
CANDLE_GAP_RECONCILIATION_MAX_DELAY_MS=10000

# Informational safety flag. No order execution exists in this service.
LIVE_TRADING_ENABLED=false

# Human-readable local logs (pretty) or newline-delimited structured records (json).
LOG_FORMAT=pretty

# Read-only microstructure persistence and health settings.
MICROSTRUCTURE_SAMPLE_INTERVAL_MS=250
MICROSTRUCTURE_STARTUP_GRACE_MS=15000
MICROSTRUCTURE_DEPTH_STALE_AFTER_MS=10000
MICROSTRUCTURE_TRADES_STALE_AFTER_MS=120000
MICROSTRUCTURE_MARKET_PRICE_STALE_AFTER_MS=30000
MICROSTRUCTURE_BATCH_SIZE=500
MICROSTRUCTURE_BOOTSTRAP_TRADE_LIMIT=10000
MICROSTRUCTURE_MAX_BOOK_AGE_MS=2000
MICROSTRUCTURE_MAX_PRICE_AGE_MS=5000
MICROSTRUCTURE_QUALITY_HOURS=24
DATA_RUNTIME_SHUTDOWN_TIMEOUT_MS=10000

# Deterministic EMA backtest strategy. Periods must satisfy fast < slow < trend.
EMA_FAST_PERIOD=9
EMA_SLOW_PERIOD=21
EMA_TREND_PERIOD=50
EMA_MAXIMUM_HOLDING_BARS=48

# Print individual backtest trades only when explicitly enabled.
BACKTEST_VERBOSE=false

# Confirmed 1h market-structure pivot windows.
SWING_LEFT_BARS=2
SWING_RIGHT_BARS=2

# Confirmed 15m breakout setup filters.
BREAKOUT_RANGE_WINDOW=20
BREAKOUT_SHORT_ATR_WINDOW=5
BREAKOUT_LONG_ATR_WINDOW=14
BREAKOUT_COMPRESSION_RATIO=0.75
BREAKOUT_VOLUME_MULTIPLE=1.5

# Research-only 5m opportunity scanner thresholds.
OPPORTUNITY_BREAKOUT_RANGE_BARS=6
OPPORTUNITY_BREAKOUT_VOLUME_RATIO=1.2
OPPORTUNITY_BREAKOUT_MINIMUM_SCORE=85
OPPORTUNITY_PULLBACK_LOOKBACK_BARS=6
OPPORTUNITY_PULLBACK_MINIMUM_MOVE_RATIO=0.001
OPPORTUNITY_PULLBACK_MINIMUM_SCORE=85
OPPORTUNITY_RETEST_TOLERANCE_RATIO=0.001
OPPORTUNITY_RETEST_MINIMUM_REJECTION_RATIO=0.35
OPPORTUNITY_RETEST_MINIMUM_SCORE=85
OPPORTUNITY_EXPANSION_LOOKBACK_BARS=12
OPPORTUNITY_EXPANSION_VOLATILITY_RATIO=1.6
OPPORTUNITY_EXPANSION_VOLUME_RATIO=1.2
OPPORTUNITY_EXPANSION_MINIMUM_SCORE=85

# Offline outcome cost assumptions. Decibel tier-0 defaults as decimal rates.
OUTCOME_MAKER_FEE_RATE=0.00011
OUTCOME_TAKER_FEE_RATE=0.00034
OUTCOME_SLIPPAGE_RATE=0.0005

# Offline post-only maker execution research. The fee is an explicit Decibel tier-0 maker rate.
MAKER_SIMULATOR_ENTRY_OFFSET_TICKS=0
MAKER_SIMULATOR_TTL_SECONDS=30
MAKER_SIMULATOR_PLACEMENT_LATENCY_MS=250
MAKER_SIMULATOR_CANCEL_LATENCY_MS=250
MAKER_SIMULATOR_FEE_RATE=0.00011
MAKER_SIMULATOR_STARTING_EQUITY=10000
MAKER_SIMULATOR_RISK_PER_CANDIDATE=0.0025
MAKER_SIMULATOR_LEVERAGE_CAP=2

# Fixed walk-forward research-edge analysis; these do not tune candidate or execution parameters.
RESEARCH_EDGE_MINIMUM_TRAINING_SAMPLES=100
RESEARCH_EDGE_TEST_BLOCK_SIZE=25
RESEARCH_EDGE_EMBARGO_MINUTES=60
