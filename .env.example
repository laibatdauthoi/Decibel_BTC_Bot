# Decibel BTC/USD market-making bot. Copy to .env and fill in. Never commit .env.
# Start with: npm run decibel:production   (dashboard: http://127.0.0.1:4173)

# ---- Network and execution mode (safe defaults: no live orders) ----
DECIBEL_NETWORK=mainnet
DECIBEL_EXECUTION_MODE=production
# DISABLED | CANARY | AUTONOMOUS
DECIBEL_EXECUTION_RELEASE_STAGE=DISABLED
DECIBEL_EXECUTOR_ENABLED=false
DECIBEL_EXECUTOR_DRY_RUN=true
# Live orders need BOTH TRADING_MODE=mainnet and LIVE_TRADING_ENABLED=true.
TRADING_MODE=live
LIVE_TRADING_ENABLED=false
DECIBEL_PRODUCTION_EXECUTOR_MODULE=src/decibel_external_production_executor_v1.ts

# ---- Account ----
# No private key and no account address needed: connect Petra in the dashboard (top bar,
# CONNECT WALLET), pick the subaccount, CONFIRM. The owner wallet must be listed in
# config/allowed_wallets.json (see config/allowed_wallets.example.json).
# Aptos / Decibel API key (Bearer token). The bot never prints it.
DECIBEL_NODE_API_KEY=
# Optional Geomi Gas Station key: sponsors the gas of the bot's transactions, so the bot key
# needs no APT and CONFIRM asks for no APT transfer. Without it the bot key pays its own gas
# (Decibel sponsors gas only for transactions sent from its own web app).
DECIBEL_GAS_STATION_API_KEY=

# Terminal shows a compact view; true prints the raw runtime lines (stdout.log keeps them all).
DECIBEL_TERMINAL_VERBOSE=false

# ---- Dashboard ----
# off (local, default) | wallet (sign in with the owner wallet in Petra)
DECIBEL_DASHBOARD_AUTH=off
# true only when the dashboard is served over HTTPS
DECIBEL_DASHBOARD_COOKIE_SECURE=false

# ---- Optional overrides (defaults live in data/wallets/<owner>/) ----
# DECIBEL_EXECUTION_JOURNAL_PATH=
# DECIBEL_PRODUCTION_SESSION_STORE_PATH=
# DECIBEL_OPERATOR_SETTINGS_PATH=
# DECIBEL_PRODUCTION_FORENSICS_PATH=
